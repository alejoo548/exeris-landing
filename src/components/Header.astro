---

---

<header
  id="main-header"
  class="fixed top-0 w-full z-[60] transition-all duration-300"
>
  <div
    id="header-panel"
    class="glass-panel mx-auto max-w-7xl mt-6 mx-4 md:mx-auto border-x-0 border-t-0 border-b border-[#5C6B73]/20 px-8 py-4 flex justify-between items-center transition-all duration-300"
  >
    <!-- Logo -->
    <a class="flex items-center group" href="#">
      <img
        src="/logoprincipalB72ppi.png"
        alt="EXERIS - Alta Precisión Quirúrgica"
        class="h-10 w-auto object-contain brightness-110 group-hover:brightness-125 transition-all duration-300"
      />
    </a>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center space-x-12">
      <a
        class="text-[9px] font-bold tracking-widest text-[#5C6B73] hover:text-[#F2F4F6] transition-colors uppercase font-manrope"
        href="#home">INICIO</a
      >
      <a
        class="text-[9px] font-bold tracking-widest text-[#5C6B73] hover:text-[#F2F4F6] transition-colors uppercase font-manrope"
        href="#specialties">ESPECIALIDADES</a
      >
      <a
        class="text-[9px] font-bold tracking-widest text-[#5C6B73] hover:text-[#F2F4F6] transition-colors uppercase font-manrope"
        href="#technology">TECNOLOGÍA</a
      >
      <a
        class="bg-transparent border border-[#5C6B73]/40 hover:border-[#D4FF5F] text-[#D4FF5F] hover:bg-[#D4FF5F]/5 px-8 py-2 text-[9px] font-bold uppercase tracking-wider clip-tech transition-all font-manrope"
        href="#contact"
      >
        AGENDAR CITA
      </a>
    </nav>

    <!-- Mobile Toggle -->
    <button id="mobile-menu-btn" class="md:hidden text-[#F2F4F6]">
      <span class="material-symbols-outlined text-3xl">menu</span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden glass-panel mx-4 mt-2 p-6 space-y-4 border border-[#5C6B73]/20"
  >
    <a
      class="block text-sm font-bold tracking-wider text-[#5C6B73] hover:text-[#F2F4F6] transition-colors uppercase font-manrope py-2"
      href="#home">INICIO</a
    >
    <a
      class="block text-sm font-bold tracking-wider text-[#5C6B73] hover:text-[#F2F4F6] transition-colors uppercase font-manrope py-2"
      href="#specialties">ESPECIALIDADES</a
    >
    <a
      class="block text-sm font-bold tracking-wider text-[#5C6B73] hover:text-[#F2F4F6] transition-colors uppercase font-manrope py-2"
      href="#technology">TECNOLOGÍA</a
    >
    <a
      class="block w-full text-center bg-transparent border border-[#5C6B73]/40 text-[#D4FF5F] px-8 py-3 text-sm font-bold uppercase tracking-wider clip-tech transition-all font-manrope mt-4"
      href="#contact">AGENDAR CITA</a
    >
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  if (btn && menu) {
    btn.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }

  // Header Scroll Effect
  const headerPanel = document.getElementById("header-panel");

  window.addEventListener(
    "scroll",
    () => {
      if (window.scrollY > 50) {
        headerPanel?.classList.replace("mt-6", "mt-2");
        headerPanel?.classList.replace("py-4", "py-2");
        headerPanel?.classList.replace("px-8", "px-6");
        headerPanel?.classList.add("bg-[#121413]/80", "backdrop-blur-md");
      } else {
        headerPanel?.classList.replace("mt-2", "mt-6");
        headerPanel?.classList.replace("py-2", "py-4");
        headerPanel?.classList.replace("px-6", "px-8");
        headerPanel?.classList.remove("bg-[#121413]/80", "backdrop-blur-md");
      }
    },
    { passive: true },
  );
</script>
