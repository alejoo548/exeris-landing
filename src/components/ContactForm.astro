---

---

<section
  id="contact"
  class="py-24 md:py-32 bg-[#121413] relative overflow-hidden border-t border-[#5C6B73]/20"
>
  <div class="absolute inset-0 grid-precision opacity-20"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">
      <!-- Left: Info -->
      <div id="contact-info" class="text-white flex flex-col justify-center">
        <div class="contact-info-item opacity-0 translate-y-4 mb-6">
          <span
            class="text-[#5C6B73] text-[8px] font-bold tracking-[0.2em] uppercase border border-[#5C6B73]/40 px-3 py-2 font-space"
          >
            CONTACTO
          </span>
        </div>

        <h2
          class="contact-info-item opacity-0 translate-y-4 text-3xl md:text-4xl lg:text-5xl font-syncopate font-bold uppercase mb-8 leading-tight tracking-wider text-[#F2F4F6]"
        >
          INICIAR PROTOCOLO <br />
          <span class="text-[#5C6B73]">DE DIAGNÓSTICO</span>
        </h2>

        <p
          class="contact-info-item opacity-0 translate-y-4 text-[#5C6B73] mb-12 max-w-md font-manrope text-base md:text-lg font-light leading-[1.8]"
        >
          Programe una valoración técnica con nuestros especialistas. Respuesta
          prioritaria garantizada.
        </p>

        <div class="space-y-8 border-l-2 border-[#5C6B73]/20 pl-6">
          <div
            class="contact-info-item opacity-0 translate-y-4 flex items-start group"
          >
            <span
              class="material-symbols-outlined text-[#5C6B73] mr-5 mt-1 text-2xl group-hover:text-[#D4FF5F] transition-colors"
            >
              call
            </span>
            <div>
              <p
                class="text-[8px] text-[#5C6B73] uppercase tracking-wider font-space mb-1"
              >
                LÍNEA DIRECTA
              </p>
              <p
                class="text-lg md:text-xl font-bold font-syncopate text-[#F2F4F6] group-hover:text-[#D4FF5F] transition-colors tracking-wider"
              >
                +52 (55) 1234-5678
              </p>
            </div>
          </div>

          <div
            class="contact-info-item opacity-0 translate-y-4 flex items-start group"
          >
            <span
              class="material-symbols-outlined text-[#5C6B73] mr-5 mt-1 text-2xl group-hover:text-[#D4FF5F] transition-colors"
            >
              mail
            </span>
            <div>
              <p
                class="text-[8px] text-[#5C6B73] uppercase tracking-wider font-space mb-1"
              >
                COMUNICACIÓN DIGITAL
              </p>
              <p
                class="text-lg md:text-xl font-bold font-syncopate text-[#F2F4F6] group-hover:text-[#D4FF5F] transition-colors tracking-wider"
              >
                CITAS@EXERIS.MX
              </p>
            </div>
          </div>

          <div class="flex items-start group">
            <span
              class="material-symbols-outlined text-[#5C6B73] mr-5 mt-1 text-2xl group-hover:text-[#D4FF5F] transition-colors"
            >
              location_on
            </span>
            <div>
              <p
                class="text-[8px] text-[#5C6B73] uppercase tracking-wider font-space mb-1"
              >
                BASE DE OPERACIONES
              </p>
              <p
                class="text-lg md:text-xl font-bold font-syncopate text-[#F2F4F6] group-hover:text-[#D4FF5F] transition-colors tracking-wider"
              >
                TORRE MÉDICA SUR, NIVEL 4
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div
        id="contact-form-container"
        class="glass-panel p-8 md:p-12 border border-[#5C6B73]/30 relative"
      >
        <div
          class="absolute top-0 left-0 w-full h-[0.5px] bg-gradient-to-r from-transparent via-[#5C6B73]/50 to-transparent"
        >
        </div>

        <form action="#" class="space-y-8">
          <div class="grid grid-cols-1 gap-8">
            <div
              class="contact-form-item opacity-0 translate-x-4 relative group"
            >
              <label
                class="block text-[8px] font-bold text-[#5C6B73] uppercase tracking-wider mb-3 font-space group-hover:text-[#F2F4F6] transition-colors"
                for="name">NOMBRE DEL PACIENTE</label
              >
              <input
                class="w-full bg-transparent border-b border-[#5C6B73]/30 border-t-0 border-x-0 px-0 py-3 text-[#F2F4F6] focus:outline-none focus:border-[#5C6B73] transition-all placeholder-[#5C6B73]/30 font-manrope text-base"
                id="name"
                placeholder="Ingrese nombre completo"
                type="text"
              />
            </div>

            <div
              class="contact-form-item opacity-0 translate-x-4 relative group"
            >
              <label
                class="block text-[8px] font-bold text-[#5C6B73] uppercase tracking-wider mb-3 font-space group-hover:text-[#F2F4F6] transition-colors"
                for="email">CORREO ELECTRÓNICO</label
              >
              <input
                class="w-full bg-transparent border-b border-[#5C6B73]/30 border-t-0 border-x-0 px-0 py-3 text-[#F2F4F6] focus:outline-none focus:border-[#5C6B73] transition-all placeholder-[#5C6B73]/30 font-manrope text-base"
                id="email"
                placeholder="correo@ejemplo.com"
                type="email"
              />
            </div>

            <div
              class="contact-form-item opacity-0 translate-x-4 relative group"
            >
              <label
                class="block text-[8px] font-bold text-[#5C6B73] uppercase tracking-wider mb-3 font-space group-hover:text-[#F2F4F6] transition-colors"
                for="service">TIPO DE CONSULTA</label
              >
              <select
                class="w-full bg-transparent border-b border-[#5C6B73]/30 border-t-0 border-x-0 px-0 py-3 text-[#F2F4F6] focus:outline-none focus:border-[#5C6B73] transition-all font-manrope text-base"
                id="service"
              >
                <option class="bg-[#121413]">Valoración General</option>
                <option class="bg-[#121413]">Cirugía Robótica</option>
                <option class="bg-[#121413]">Traumatología</option>
              </select>
            </div>
          </div>

          <div class="contact-form-item opacity-0 translate-y-4 pt-6">
            <button
              type="submit"
              class="w-full bg-[#D4FF5F] hover:bg-[#c9f550] text-[#121413] font-bold uppercase tracking-wider py-5 text-[9px] clip-tech transition-all font-manrope flex items-center justify-center gap-2"
            >
              ENVIAR SOLICITUD
              <span class="material-symbols-outlined text-base">send</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, inView, stagger } from "motion";

  document.addEventListener("DOMContentLoaded", () => {
    inView(
      "#contact",
      () => {
        // @ts-ignore
        animate(
          ".contact-info-item",
          { opacity: 1, y: 0 },
          { duration: 0.6, delay: stagger(0.1), easing: [0.22, 1, 0.36, 1] },
        );

        setTimeout(() => {
          // @ts-ignore
          animate(
            ".contact-form-item",
            { opacity: 1, x: 0, y: 0 },
            { duration: 0.6, delay: stagger(0.1), easing: [0.22, 1, 0.36, 1] },
          );
        }, 300);
      },
      { margin: "-200px" },
    );
  });
</script>
