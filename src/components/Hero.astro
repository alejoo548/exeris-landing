---

---

<section
  id="home"
  class="relative min-h-screen flex items-center pt-32 pb-24 overflow-hidden bg-[#121413]"
>
  <!-- Grid de precisión -->
  <div class="absolute inset-0 z-0 grid-precision opacity-40"></div>

  <!-- Líneas estructurales -->
  <div class="absolute inset-0 z-[1] pointer-events-none hidden lg:block">
    <div class="absolute top-[10%] left-[8%] w-[0.5px] h-[85%] bg-[#5C6B73]/20">
    </div>
    <div
      class="absolute top-[10%] right-[8%] w-[0.5px] h-[85%] bg-[#5C6B73]/20"
    >
    </div>
    <div class="absolute top-[10%] left-[8%] w-[84%] h-[0.5px] bg-[#5C6B73]/20">
    </div>
    <div
      class="absolute bottom-[5%] left-[8%] w-[84%] h-[0.5px] bg-[#5C6B73]/20"
    >
    </div>

    <!-- Data Decor -->
    <span class="data-marker top-[8%] left-[8%] absolute">REF: 01-A</span>
    <span class="data-marker top-[8%] right-[8%] absolute">13.6981° N</span>
    <span class="data-marker bottom-[3%] left-[8%] absolute">SYS: NORMAL</span>
    <span class="data-marker bottom-[3%] right-[8%] absolute">89.1915° W</span>
  </div>

  <div
    class="relative z-10 max-w-7xl mx-auto px-6 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center w-full gap-16 lg:gap-20"
  >
    <!-- Left: Text -->
    <div class="lg:w-1/2 space-y-10 text-center lg:text-left relative z-20">
      <div
        class="inline-flex items-center space-x-3 border-l-2 border-[#5C6B73] pl-4"
      >
        <span
          class="text-[8px] font-space tracking-wider uppercase text-[#5C6B73]"
        >
          SISTEMA OPERATIVO // V.4.0
        </span>
      </div>

      <h1
        class="font-syncopate font-bold text-[2.75rem] leading-[0.9] sm:text-5xl md:text-6xl lg:text-7xl tracking-widest"
      >
        <span class="block text-[#F2F4F6]">PRECISIÓN</span>
        <span class="block text-[#5C6B73]">QUIRÚRGICA</span>
        <span class="block text-[#F2F4F6]">DE ÉLITE</span>
      </h1>

      <p
        class="text-[0.95rem] md:text-base text-[#5C6B73] max-w-md mx-auto lg:mx-0 font-manrope font-light leading-[1.8] tracking-wide border-l-2 border-[#5C6B73]/30 pl-5"
      >
        Intervención robótica de mínima invasión. Diagnósticos asistidos por IA.
        Estándar internacional en medicina regenerativa.
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-4"
      >
        <a
          href="#contact"
          class="bg-[#D4FF5F] hover:bg-[#c9f550] text-[#121413] px-10 py-4 text-[9px] font-bold font-manrope uppercase tracking-wider clip-tech transition-all flex items-center justify-center gap-2 group"
        >
          CONTACTAR ESPECIALISTA
          <span
            class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform"
            >arrow_forward</span
          >
        </a>
        <a
          href="#specialties"
          class="border border-[#5C6B73]/40 hover:border-[#5C6B73] text-[#F2F4F6] px-10 py-4 text-[9px] font-bold font-manrope uppercase tracking-wider clip-tech transition-all hover:bg-[#5C6B73]/5 flex items-center justify-center gap-2"
        >
          PROTOCOLOS
        </a>
      </div>

      <!-- Stats con diseño mejorado -->
      <div class="pt-12 mt-12 relative">
        <!-- Decoración de línea técnica -->
        <div class="absolute top-0 left-0 w-24 h-[1px] bg-[#D4FF5F]/50"></div>

        <div class="flex flex-wrap gap-6 justify-center lg:justify-start">
          <div
            class="glass-panel clip-tech p-6 min-w-[160px] border-l-2 border-l-[#D4FF5F]/30 hover:bg-[#D4FF5F]/5 transition-colors group"
          >
            <div class="flex items-baseline gap-1">
              <span
                class="block text-3xl md:text-4xl font-syncopate text-[#F2F4F6] font-bold tracking-tighter group-hover:text-[#D4FF5F] transition-colors"
                >99.8%</span
              >
            </div>
            <div class="flex items-center gap-2 mt-3">
              <span class="w-1 h-1 bg-[#D4FF5F]"></span>
              <span
                class="text-[8px] uppercase tracking-[0.2em] text-[#5C6B73] font-space"
                >EFICACIA OPERATIVA</span
              >
            </div>
          </div>

          <div
            class="glass-panel clip-tech p-6 min-w-[160px] border-l-2 border-l-[#D4FF5F]/30 hover:bg-[#D4FF5F]/5 transition-colors group"
          >
            <div class="flex items-baseline gap-1">
              <span
                class="block text-3xl md:text-4xl font-syncopate text-[#F2F4F6] font-bold tracking-tighter group-hover:text-[#D4FF5F] transition-colors"
                >15+</span
              >
            </div>
            <div class="flex items-center gap-2 mt-3">
              <span class="w-1 h-1 bg-[#D4FF5F]"></span>
              <span
                class="text-[8px] uppercase tracking-[0.2em] text-[#5C6B73] font-space"
                >AÑOS DE EXPERIENCIA</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Image Carousel -->
    <div class="lg:w-1/2 mt-20 lg:mt-0 relative w-full">
      <div class="relative z-10 w-full max-w-xl mx-auto">
        <!-- Swiper Carousel -->
        <div class="swiper hero-swiper clip-tech border border-[#5C6B73]/30">
          <div class="swiper-wrapper">
            <div class="swiper-slide">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDz13VtOU7cXOybhcKFFoP-6ZiD-5S8SCtse56oWYkN3qxko4TODJdRop2XIKs7GPnFG5CtnjVL_H4lnC4_uVVw_YzEwjJvK6Nhso_gbsCbVSNbe2LhMztDWLRi-gpyp0bFGpJnI4XkHx6Cwz3tmU2vkAyflWAFZWKN5mn2gflKkGxH5O-YNsJg-uXK3nXSkFZPjo5Kx8FkdT57U-CzxTYwNuV5cplrddwYX7SO55VyM7RyWLv15hnzNkmzZUfFj7MLZ9db-spDeDCf"
                alt="Cirugía Robótica"
                class="w-full h-full object-cover grayscale contrast-125"
              />
            </div>
            <div class="swiper-slide">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuC6qCmPuCLw1HmaEd9wTJvGsV_QZ7AmhBjPhyG7W017iM7YboBdZgGLqreZQOPNFHx4B1tkPUxhbXRLlyZtFb1Ww1T7pGxB43wX3mt8UK8s5P-vkgYQAehGv8xEs6ac5m-Kuz-VCksgYVXE8CA5LJhNJu2c4PykOOIN9HUhW-6PMWz3S5-W6tRvNYxsCeHwGY4k_zMcQnGlsZmVtHLyfU1l-83MeHoLLxfGus_92TNJ2VvUX6ihdiSDbdvMYObVbYWdy0nR6Wx8ej2O"
                alt="Profesional Médico"
                class="w-full h-full object-cover grayscale contrast-125"
              />
            </div>
            <div class="swiper-slide">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDz13VtOU7cXOybhcKFFoP-6ZiD-5S8SCtse56oWYkN3qxko4TODJdRop2XIKs7GPnFG5CtnjVL_H4lnC4_uVVw_YzEwjJvK6Nhso_gbsCbVSNbe2LhMztDWLRi-gpyp0bFGpJnI4XkHx6Cwz3tmU2vkAyflWAFZWKN5mn2gflKkGxH5O-YNsJg-uXK3nXSkFZPjo5Kx8FkdT57U-CzxTYwNuV5cplrddwYX7SO55VyM7RyWLv15hnzNkmzZUfFj7MLZ9db-spDeDCf"
                alt="Tecnología Avanzada"
                class="w-full h-full object-cover grayscale contrast-125"
              />
            </div>
          </div>
          <!-- Pagination -->
          <div class="swiper-pagination"></div>
        </div>

        <!-- Panel de diagnóstico mejorado -->
        <div
          class="absolute -bottom-8 -right-4 glass-panel p-5 min-w-[200px] border-r-2 border-r-[#D4FF5F] z-30 hidden md:block scanline-effect shadow-2xl"
        >
          <div class="flex justify-between items-start mb-4">
            <div class="space-y-1">
              <p
                class="text-[7px] text-[#5C6B73] font-space tracking-[0.3em] uppercase"
              >
                Status Check
              </p>
              <h4 class="text-[10px] font-syncopate font-bold text-[#F2F4F6]">
                DIAGNÓSTICO
              </h4>
            </div>
            <div class="flex gap-1">
              <div class="w-1 h-1 bg-[#D4FF5F]/30"></div>
              <div class="w-1 h-1 bg-[#D4FF5F]/30"></div>
              <div class="w-1 h-1 bg-[#D4FF5F]"></div>
            </div>
          </div>

          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[8px] text-[#5C6B73] font-space">SISTEMA</span>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-[#D4FF5F] animate-pulse"></span>
                <span
                  class="text-[9px] font-bold text-[#D4FF5F] font-syncopate tracking-wider uppercase"
                  >En Línea</span
                >
              </div>
            </div>

            <div class="h-[1px] w-full bg-[#5C6B73]/20"></div>

            <div class="flex items-center justify-between">
              <span class="text-[8px] text-[#5C6B73] font-space"
                >CALIBRACIÓN</span
              >
              <span
                class="text-[9px] font-bold text-[#F2F4F6] font-syncopate tracking-wider"
                >99% OPT</span
              >
            </div>
          </div>

          <!-- Decoración técnica inferior -->
          <div class="absolute bottom-1 right-1">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              class="opacity-20 text-[#D4FF5F]"
            >
              <path
                d="M4 4h4v4H4V4zM16 4h4v4h-4V4zM4 16h4v4H4v-4zM16 16h4v4h-4v-4z"
                fill="currentColor"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hero-swiper {
    overflow: hidden;
  }
  .hero-swiper .swiper-slide {
    overflow: hidden;
  }
  .hero-swiper .swiper-slide img {
    display: block;
    width: 100%;
  }
  .hero-swiper .swiper-pagination {
    bottom: 12px !important;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .hero-swiper .swiper-pagination-bullet {
    width: 2rem;
    height: 1px;
    border-radius: 0;
    background: rgba(92, 107, 115, 0.3);
    opacity: 1;
    transition: all 0.3s ease;
  }
  .hero-swiper .swiper-pagination-bullet-active {
    background: #5c6b73;
    width: 3rem;
  }
</style>

<script>
  import Swiper from "swiper";
  import { EffectFade, Autoplay, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/effect-fade";
  import "swiper/css/pagination";

  document.addEventListener("DOMContentLoaded", () => {
    new Swiper(".hero-swiper", {
      modules: [EffectFade, Autoplay, Pagination],
      effect: "fade",
      fadeEffect: {
        crossFade: true,
      },
      speed: 1000,
      loop: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
    });
  });
</script>
