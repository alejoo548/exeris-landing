---

<section class="py-12 md:py-16 bg-[#121413] border-y border-[#5C6B73]/20 overflow-hidden relative">
  <div class="absolute inset-0 grid-precision opacity-20"></div>
  
  <div class="max-w-7xl mx-auto px-6 sm:px-6 lg:px-8 relative z-10">
    <p
      class="text-center text-[#5C6B73] text-[7px] md:text-[8px] uppercase tracking-[0.2em] font-space mb-10"
    >
      CERTIFICACIONES INTERNACIONALES // AFILIACIONES
    </p>
    <div
      class="flex flex-wrap justify-center items-center gap-12 md:gap-16 lg:gap-24 opacity-70"
    >
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-2xl md:text-3xl text-[#5C6B73]"
          >local_hospital</span
        >
        <span class="font-syncopate font-bold text-base md:text-lg text-[#F2F4F6] tracking-wider"
          >MED<span class="font-normal text-[#5C6B73]">CERT</span></span
        >
      </div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-2xl md:text-3xl text-[#5C6B73]"
          >verified_user</span
        >
        <span class="font-syncopate font-bold text-base md:text-lg text-[#F2F4F6] tracking-wider"
          >ISO<span class="font-normal text-[#5C6B73]">9001</span></span
        >
      </div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-2xl md:text-3xl text-[#5C6B73]"
          >health_and_safety</span
        >
        <span class="font-syncopate font-bold text-base md:text-lg text-[#F2F4F6] tracking-wider"
          >SURG<span class="font-normal text-[#5C6B73]">TECH</span></span
        >
      </div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-2xl md:text-3xl text-[#5C6B73]"
          >award_star</span
        >
        <span class="font-syncopate font-bold text-base md:text-lg text-[#F2F4F6] tracking-wider"
          >TOP<span class="font-normal text-[#5C6B73]">DOCS</span></span
        >
      </div>
    </div>
  </div>
</section>
