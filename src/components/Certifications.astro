---

---

<section
  class="py-12 md:py-16 bg-[#121413] border-y border-[#5C6B73]/20 overflow-hidden relative"
>
  <div class="absolute inset-0 grid-precision opacity-20"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-6 lg:px-8 relative z-10">
    <p
      class="text-center text-[#5C6B73] text-[7px] md:text-[8px] uppercase tracking-[0.2em] font-space mb-10"
    >
      CERTIFICACIONES INTERNACIONALES // AFILIACIONES
    </p>
    <div
      id="cert-container"
      class="flex flex-wrap justify-center items-center gap-12 md:gap-16 lg:gap-24 opacity-70"
    >
      <div
        class="cert-item opacity-0 translate-y-8 flex items-center gap-2 transition-all duration-300 hover:scale-110 hover:drop-shadow-[0_0_15px_rgba(212,255,95,0.4)] cursor-default"
      >
        <span
          class="material-symbols-outlined text-2xl md:text-3xl text-[#5C6B73] transition-colors group-hover:text-[#D4FF5F]"
          >local_hospital</span
        >
        <span
          class="font-syncopate font-bold text-base md:text-lg text-[#F2F4F6] tracking-wider transition-colors group-hover:text-white"
          >MED<span class="font-normal text-[#5C6B73] transition-colors"
            >CERT</span
          ></span
        >
      </div>
      <div
        class="cert-item opacity-0 translate-y-8 flex items-center gap-2 transition-all duration-300 hover:scale-110 hover:drop-shadow-[0_0_15px_rgba(212,255,95,0.4)] cursor-default"
      >
        <span
          class="material-symbols-outlined text-2xl md:text-3xl text-[#5C6B73] transition-colors group-hover:text-[#D4FF5F]"
          >verified_user</span
        >
        <span
          class="font-syncopate font-bold text-base md:text-lg text-[#F2F4F6] tracking-wider transition-colors group-hover:text-white"
          >ISO<span class="font-normal text-[#5C6B73] transition-colors"
            >9001</span
          ></span
        >
      </div>
      <div
        class="cert-item opacity-0 translate-y-8 flex items-center gap-2 transition-all duration-300 hover:scale-110 hover:drop-shadow-[0_0_15px_rgba(212,255,95,0.4)] cursor-default"
      >
        <span
          class="material-symbols-outlined text-2xl md:text-3xl text-[#5C6B73] transition-colors group-hover:text-[#D4FF5F]"
          >health_and_safety</span
        >
        <span
          class="font-syncopate font-bold text-base md:text-lg text-[#F2F4F6] tracking-wider transition-colors group-hover:text-white"
          >SURG<span class="font-normal text-[#5C6B73] transition-colors"
            >TECH</span
          ></span
        >
      </div>
      <div
        class="cert-item opacity-0 translate-y-8 flex items-center gap-2 transition-all duration-300 hover:scale-110 hover:drop-shadow-[0_0_15px_rgba(212,255,95,0.4)] cursor-default"
      >
        <span
          class="material-symbols-outlined text-2xl md:text-3xl text-[#5C6B73] transition-colors group-hover:text-[#D4FF5F]"
          >award_star</span
        >
        <span
          class="font-syncopate font-bold text-base md:text-lg text-[#F2F4F6] tracking-wider transition-colors group-hover:text-white"
          >TOP<span class="font-normal text-[#5C6B73] transition-colors"
            >DOCS</span
          ></span
        >
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, inView, stagger } from "motion";

  document.addEventListener("DOMContentLoaded", () => {
    inView(
      "#cert-container",
      () => {
        // @ts-ignore
        animate(
          ".cert-item",
          { opacity: 1, y: 0 },
          { duration: 0.8, delay: stagger(0.15), easing: [0.22, 1, 0.36, 1] },
        );
      },
      { margin: "-50px" },
    );
  });
</script>
