---

---

<section
  id="specialties"
  class="py-24 md:py-32 bg-[#121413] relative overflow-hidden"
>
  <div class="absolute inset-0 grid-precision opacity-30"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="mb-20 md:mb-24">
      <span
        class="text-[#5C6B73] text-[8px] md:text-[9px] font-bold tracking-[0.2em] uppercase block mb-4 font-space"
        >EXERIS MEDICAL // ÁREAS DE INTERVENCIÓN</span
      >
      <h2
        class="specialties-title opacity-0 translate-y-4 text-[2rem] sm:text-3xl md:text-4xl lg:text-5xl font-syncopate font-bold text-[#F2F4F6] uppercase tracking-wider leading-tight"
      >
        PROTOCOLOS <span class="text-[#5C6B73]">QUIRÚRGICOS</span>
      </h2>
      <div class="h-[0.5px] w-32 bg-[#5C6B73]/40 mt-6"></div>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      <!-- Card 1: Cirugía General -->
      <div class="specialty-card opacity-0 translate-y-8 p-8 md:p-10 group">
        <div
          class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        >
          <span class="text-[7px] text-[#5C6B73] font-space tracking-wider"
            >SYS.01</span
          >
        </div>
        <div class="flex items-start justify-between mb-8">
          <div
            class="w-12 h-12 bg-transparent border border-[#5C6B73]/30 flex items-center justify-center group-hover:border-[#5C6B73] transition-colors text-[#5C6B73]"
          >
            <span class="material-symbols-outlined text-xl"
              >medical_services</span
            >
          </div>
          <div
            class="w-1 h-1 bg-[#5C6B73] opacity-50 group-hover:opacity-100 transition-opacity"
          >
          </div>
        </div>
        <h3
          class="text-lg md:text-xl font-syncopate font-bold text-[#F2F4F6] uppercase mb-4 tracking-wider group-hover:text-[#D4FF5F] transition-colors"
        >
          CIRUGÍA GENERAL
        </h3>
        <p
          class="text-[#5C6B73] text-[0.9rem] leading-[1.7] mb-8 font-manrope font-light"
        >
          Intervenciones de alta complejidad con énfasis en recuperación rápida
          y mínima invasión utilizando tecnología robótica de última generación.
        </p>
        <div
          class="w-full h-[0.5px] bg-[#5C6B73]/20 group-hover:bg-[#5C6B73]/40 mb-4 transition-colors"
        >
        </div>
        <a
          href="#"
          class="inline-flex items-center text-[8px] font-bold uppercase tracking-wider text-[#5C6B73] group-hover:text-[#F2F4F6] transition-colors font-manrope"
        >
          VER ESPECIFICACIONES
          <span class="material-symbols-outlined text-[10px] ml-2"
            >arrow_forward</span
          >
        </a>
      </div>

      <!-- Card 2: Laparoscopía -->
      <div class="specialty-card opacity-0 translate-y-8 p-8 md:p-10 group">
        <div
          class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        >
          <span class="text-[7px] text-[#5C6B73] font-space tracking-wider"
            >SYS.02</span
          >
        </div>
        <div class="flex items-start justify-between mb-8">
          <div
            class="w-12 h-12 bg-transparent border border-[#5C6B73]/30 flex items-center justify-center group-hover:border-[#5C6B73] transition-colors text-[#5C6B73]"
          >
            <span class="material-symbols-outlined text-xl">visibility</span>
          </div>
          <div
            class="w-1 h-1 bg-[#5C6B73] opacity-50 group-hover:opacity-100 transition-opacity"
          >
          </div>
        </div>
        <h3
          class="text-lg md:text-xl font-syncopate font-bold text-[#F2F4F6] uppercase mb-4 tracking-wider group-hover:text-[#D4FF5F] transition-colors"
        >
          LAPAROSCOPÍA
        </h3>
        <p
          class="text-[#5C6B73] text-[0.9rem] leading-[1.7] mb-8 font-manrope font-light"
        >
          Tecnología de video cirugía avanzada para diagnósticos precisos y
          tratamientos efectivos con cicatrices imperceptibles.
        </p>
        <div
          class="w-full h-[0.5px] bg-[#5C6B73]/20 group-hover:bg-[#5C6B73]/40 mb-4 transition-colors"
        >
        </div>
        <a
          href="#"
          class="inline-flex items-center text-[8px] font-bold uppercase tracking-wider text-[#5C6B73] group-hover:text-[#F2F4F6] transition-colors font-manrope"
        >
          VER ESPECIFICACIONES
          <span class="material-symbols-outlined text-[10px] ml-2"
            >arrow_forward</span
          >
        </a>
      </div>

      <!-- Card 3: Traumatología -->
      <div class="specialty-card opacity-0 translate-y-8 p-8 md:p-10 group">
        <div
          class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        >
          <span class="text-[7px] text-[#5C6B73] font-space tracking-wider"
            >SYS.03</span
          >
        </div>
        <div class="flex items-start justify-between mb-8">
          <div
            class="w-12 h-12 bg-transparent border border-[#5C6B73]/30 flex items-center justify-center group-hover:border-[#5C6B73] transition-colors text-[#5C6B73]"
          >
            <span class="material-symbols-outlined text-xl"
              >accessibility_new</span
            >
          </div>
          <div
            class="w-1 h-1 bg-[#5C6B73] opacity-50 group-hover:opacity-100 transition-opacity"
          >
          </div>
        </div>
        <h3
          class="text-lg md:text-xl font-syncopate font-bold text-[#F2F4F6] uppercase mb-4 tracking-wider group-hover:text-[#D4FF5F] transition-colors"
        >
          TRAUMATOLOGÍA
        </h3>
        <p
          class="text-[#5C6B73] text-[0.9rem] leading-[1.7] mb-8 font-manrope font-light"
        >
          Soluciones ortopédicas integrales para la restauración completa de la
          movilidad, biomecánica avanzada y reemplazos articulares.
        </p>
        <div
          class="w-full h-[0.5px] bg-[#5C6B73]/20 group-hover:bg-[#5C6B73]/40 mb-4 transition-colors"
        >
        </div>
        <a
          href="#"
          class="inline-flex items-center text-[8px] font-bold uppercase tracking-wider text-[#5C6B73] group-hover:text-[#F2F4F6] transition-colors font-manrope"
        >
          VER ESPECIFICACIONES
          <span class="material-symbols-outlined text-[10px] ml-2"
            >arrow_forward</span
          >
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, inView, stagger } from "motion";

  document.addEventListener("DOMContentLoaded", () => {
    inView(
      "#specialties",
      () => {
        // @ts-ignore
        animate(
          ".specialties-title",
          { opacity: 1, y: 0 } as any,
          {
            duration: 0.8,
            easing: [0.22, 1, 0.36, 1],
          } as any,
        );

        // @ts-ignore
        animate(
          ".specialty-card",
          { opacity: 1, y: 0 } as any,
          {
            duration: 0.8,
            delay: stagger(0.15),
            easing: [0.22, 1, 0.36, 1],
          } as any,
        );
      },
      { margin: "-100px" as any },
    );
  });
</script>
