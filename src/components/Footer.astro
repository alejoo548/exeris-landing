---
const directoryLinks = [
  { label: "INICIO", href: "#" },
  { label: "LA FIRMA", href: "#" },
  { label: "SERVICIOS", href: "#" },
  { label: "ESPECIALISTAS", href: "#" },
];

const legalLinks = [
  { label: "PRIVACIDAD", href: "#" },
  { label: "TÉRMINOS", href: "#" },
  { label: "REGULACIÓN", href: "#" },
];

const socialLinks = [
  { label: "FB", href: "#", ariaLabel: "Visitar Facebook" },
  { label: "IG", href: "#", ariaLabel: "Visitar Instagram" },
  { label: "LN", href: "#", ariaLabel: "Visitar LinkedIn" },
];
---

<footer
  id="footer-section"
  class="bg-[#0d0e0e] text-[#5C6B73] py-16 md:py-20 border-t border-[#5C6B73]/20"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
      <!-- Brand -->
      <div class="footer-item opacity-0 translate-y-4 md:col-span-4">
        <a
          href="#"
          class="font-syncopate font-bold text-xl tracking-wider text-[#F2F4F6] mb-8 block hover:text-[#D4FF5F] transition-colors"
          >EX<span class="text-[#5C6B73]">ERIS</span></a
        >
        <p
          class="text-[9px] leading-relaxed mb-6 font-manrope max-w-xs uppercase tracking-wider text-[#5C6B73]"
        >
          ALTA TECNOLOGÍA QUIRÚRGICA. <br /> INNOVACIÓN BIOMÉDICA Y SEGURIDAD CERTIFICADA.
        </p>
      </div>

      <!-- Directory -->
      <div class="footer-item opacity-0 translate-y-4 md:col-span-2">
        <h4
          class="text-[#5C6B73] font-bold uppercase tracking-wider text-[8px] mb-6 font-space"
        >
          DIRECTORIO
        </h4>
        <ul class="space-y-3 text-[9px] font-manrope uppercase tracking-wider">
          {
            directoryLinks.map((link) => (
              <li>
                <a
                  class="hover:text-[#F2F4F6] transition-colors"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Legal -->
      <div class="footer-item opacity-0 translate-y-4 md:col-span-2">
        <h4
          class="text-[#5C6B73] font-bold uppercase tracking-wider text-[8px] mb-6 font-space"
        >
          LEGAL
        </h4>
        <ul class="space-y-3 text-[9px] font-manrope uppercase tracking-wider">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  class="hover:text-[#F2F4F6] transition-colors"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Social -->
      <div class="footer-item opacity-0 translate-y-4 md:col-span-4">
        <h4
          class="text-[#5C6B73] font-bold uppercase tracking-wider text-[8px] mb-6 font-space"
        >
          CONEXIÓN
        </h4>
        <div class="flex space-x-4">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                aria-label={social.ariaLabel}
                class="w-10 h-10 border border-[#5C6B73]/30 flex items-center justify-center hover:border-[#5C6B73] hover:text-[#F2F4F6] transition-all bg-[#121413]"
              >
                <span class="font-bold font-syncopate text-[10px]">
                  {social.label}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="footer-item opacity-0 translate-y-4 border-t border-[#5C6B73]/20 pt-8 flex flex-col md:flex-row justify-between items-center text-[8px] text-[#5C6B73] font-space uppercase tracking-wider"
    >
      <p>&copy; 2025 EXERIS MEDICAL GROUP. ALL RIGHTS RESERVED.</p>
      <div class="flex items-center gap-3 mt-4 md:mt-0">
        <span class="w-1 h-1 bg-[#5C6B73] transition-colors hover:bg-[#D4FF5F]"
        ></span>
        <span>SYSTEM OPERATIONAL // SECURE CONNECTION</span>
      </div>
    </div>
  </div>
</footer>

<script>
  import { animate, inView, stagger } from "motion";

  document.addEventListener("DOMContentLoaded", () => {
    inView(
      "#footer-section",
      () => {
        // @ts-ignore
        animate(
          ".footer-item",
          { opacity: 1, y: 0 },
          { duration: 0.6, delay: stagger(0.1), easing: [0.22, 1, 0.36, 1] },
        );
      },
      { margin: "-50px" },
    );
  });
</script>
