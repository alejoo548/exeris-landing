<canvas id="blob-canvas" class="fixed inset-0 w-full h-full -z-50 pointer-events-none"></canvas>

<script>
  const canvas = document.getElementById('blob-canvas') as HTMLCanvasElement;

  if (canvas) {
    const ctx = canvas.getContext('2d');

    let width = window.innerWidth;
    let height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;

        const blobs = [
      {
        cx: 0.3, cy: 0.3,
        rx: 0.2, ry: 0.2,
        r: 0.5,
        color: 'rgba(212, 255, 95, 0.15)',
        speed: 0.8,
        offset: 0
      },
      {
        cx: 0.7, cy: 0.7,
        rx: 0.15, ry: 0.25,
        r: 0.6,
        color: 'rgba(212, 255, 95, 0.12)',
        speed: 1.1,
        offset: Math.PI
      },
      {
        cx: 0.5, cy: 0.5,
        rx: 0.25, ry: 0.15,
        r: 0.45,
        color: 'rgba(212, 255, 95, 0.08)',
        speed: 0.9,
        offset: Math.PI / 2
      },
      {
        cx: 0.8, cy: 0.2,
        rx: 0.2, ry: 0.3,
        r: 0.4,
        color: 'rgba(212, 255, 95, 0.1)',
        speed: 0.7,
        offset: Math.PI * 1.5
      },
      {
        cx: 0.2, cy: 0.8,
        rx: 0.3, ry: 0.2,
        r: 0.55,
        color: 'rgba(212, 255, 95, 0.14)',
        speed: 1.2,
        offset: Math.PI * 0.75
      }
    ];

    window.addEventListener('resize', () => {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    });

    let time = 0;

    function animate() {
      if (!ctx) return;

      // Clear the canvas
      ctx.clearRect(0, 0, width, height);

      // Update time
      time += 0.005;

      blobs.forEach((blob) => {
        // Calculate current position based on sine waves for organic movement
        const x = (blob.cx * width) + Math.cos(time * blob.speed + blob.offset) * (blob.rx * width);
        const y = (blob.cy * height) + Math.sin(time * blob.speed + blob.offset * 2) * (blob.ry * height);

        // Responsive radius
        const radius = blob.r * Math.min(width, height);

        // Draw radial gradient
        const gradient = ctx.createRadialGradient(x, y, 0, x, y, radius);
        gradient.addColorStop(0, blob.color);
        gradient.addColorStop(1, 'rgba(212, 255, 95, 0)');

        ctx.beginPath();
        ctx.arc(x, y, radius, 0, Math.PI * 2);
        ctx.fillStyle = gradient;
        ctx.fill();
      });

      requestAnimationFrame(animate);
    }

    animate();
  }
</script>
